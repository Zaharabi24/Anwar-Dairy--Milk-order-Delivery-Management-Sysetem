# Copy to .env.local for `bun run dev` (.env.local is gitignored and never read by docker compose).
#   docker compose up -d db mailpit
# After changing anything, restart `bun run dev`.
DATABASE_URL=postgres://anwar:anwar_local_dev@localhost:5432/anwar_fresh

# Demo data + demo sign-in accounts (never enable in production).
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@12345

APP_URL=http://localhost:8080
MAIL_FROM=no-reply@anwargroup.net

# ---------------------------------------------------------------------------
# EMAIL — choose ONE option.

# 0) Local test inbox (Mailpit, http://localhost:8025). Nothing reaches real mailboxes.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_CAPTURE=true

# 1) Microsoft 365 via Microsoft Graph (recommended for @anwargroup.net mailboxes).
#    Entra ID app registration with Mail.Send *application* permission + admin consent.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER_MAILBOX=no-reply@anwargroup.net

# 2) Microsoft 365 SMTP (needs "Authenticated SMTP" enabled on the sending mailbox).
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_REQUIRE_TLS=true
# SMTP_USER=no-reply@anwargroup.net
# SMTP_PASS=
# MAIL_FROM=no-reply@anwargroup.net

# 3) On-premises Exchange / internal SMTP with a self-signed certificate.
#    Quote values containing \ or # so they're read literally.
#    SMTP_HOST takes a comma-separated list when there is more than one mail server: each email
#    goes out through the first host that accepts it, so a server that refuses the connection or
#    the credentials is skipped instead of losing the message. Put the known-good server first.
#    `node scripts/mail-probe.mjs --hosts a,b --user U --pass P` says which servers work.
# SMTP_HOST=exchange02.example.internal,exchange01.example.internal
# SMTP_PORT=25
# SMTP_REQUIRE_TLS=true
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_USER='DOMAIN\user'
# SMTP_PASS='password'
# MAIL_FROM=mailbox@anwargroup.net
# MAIL_CAPTURE=false

# 4) Any other SMTP provider (Google Workspace: smtp.gmail.com + app password; SendGrid, Brevo, ...).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
